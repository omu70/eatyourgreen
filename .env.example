# ---- Analytics credentials (replace placeholders before deploy) ----
# Meta Pixel ID (browser)
NEXT_PUBLIC_META_PIXEL_ID=TODO_META_PIXEL_ID
# Meta Conversions API (server) — keep secret, no NEXT_PUBLIC_ prefix
META_CAPI_ACCESS_TOKEN=TODO_META_CAPI_ACCESS_TOKEN
META_CAPI_PIXEL_ID=TODO_META_PIXEL_ID
# Optional Meta test event code for Test Events tool
META_TEST_EVENT_CODE=
# GA4 measurement ID
NEXT_PUBLIC_GA4_ID=TODO_GA4_MEASUREMENT_ID
# Google Tag Manager container ID (optional)
NEXT_PUBLIC_GTM_ID=
# Public site URL (for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://eatyourgreen.com

# ---- Razorpay (on-site checkout) ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=TODO_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=TODO_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=TODO_RAZORPAY_KEY_SECRET

# ---- Supabase (admin + leads/orders) ----
NEXT_PUBLIC_SUPABASE_URL=https://hbsgwulglogwxhxkqtpf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TODO_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TODO_SUPABASE_SERVICE_ROLE_KEY
# comma-separated list of emails allowed into /admin
ADMIN_EMAILS=TODO_your_admin_email@example.com
